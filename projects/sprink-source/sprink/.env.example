# Development: copy to .env.local. Production reads environment secrets only.
# Required for Ask Sprink reference retrieval. Never use a VITE_ credential variable.
TYPESAFE_API_KEY=
# Optional for Ask Sprink; required only for other workflow features.
OPENAI_API_KEY=
# Set these in the process environment, not .env.local:
# NODE_ENV=production
# SPRINK_HOST=0.0.0.0
# PORT=4310
# SPRINK_TOKEN=<random secret of at least 32 characters>
# SPRINK_DATA_DIR=/absolute/path/to/persistent/storage
# Production requires an existing field.sqlite in SPRINK_DATA_DIR.
